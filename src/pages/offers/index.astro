---
import Layout from '@/layouts/Layout.astro';
import { HomeOffersPageLayout } from '@/components/HomeOffersPageLayout';
import { OfferService } from '@/services/offer.service';

export const prerender = false;

const currentPath = Astro.url.pathname;
const accessToken = undefined;
const userProfile = Astro.locals.userProfile;

// Fetch ofert server-side — eliminuje loading flash
let initialOffersData = undefined;
if (Astro.locals.supabase) {
  try {
    const offerService = new OfferService(Astro.locals.supabase);
    initialOffersData = await offerService.listOffers({
      page: 1,
      limit: 15,
      sort: 'created_at',
      order: 'desc',
    });
  } catch {
    // Fallback: React pobierze dane client-side
  }
}
---

<Layout title="KAKAPO - Oferty">
  <HomeOffersPageLayout client:load currentPath={currentPath} initialToken={accessToken} initialUser={userProfile} initialOffersData={initialOffersData} />
</Layout>

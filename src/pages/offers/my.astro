---
import Layout from '@/layouts/Layout.astro';
import { MyOffersPageLayout } from '@/components/MyOffersPageLayout';
import { OfferService } from '@/services/offer.service';

export const prerender = false;

const currentPath = Astro.url.pathname;
const accessToken = undefined;
const userProfile = Astro.locals.userProfile;

// Fetch ofert server-side — eliminuje loading flash
let initialOffers = undefined;
if (Astro.locals.user?.id && Astro.locals.supabase) {
  try {
    const offerService = new OfferService(Astro.locals.supabase);
    initialOffers = await offerService.getMyOffers(Astro.locals.user.id, 'ACTIVE');
  } catch {
    // Fallback: React pobierze dane client-side
  }
}
---

<Layout title="KAKAPO - Moje Oferty">
  <MyOffersPageLayout client:load currentPath={currentPath} initialToken={accessToken} initialUser={userProfile} initialOffers={initialOffers} />
</Layout>
